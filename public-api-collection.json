{
  "info": {
    "name": "Lab05 — Даалгавар 5: Нийтийн API (jsonplaceholder)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /users",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{publicUrl}}/users", "host": ["{{publicUrl}}"], "path": ["users"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"GET /users: статус 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"GET /users: хариу нь хоосон биш массив\", function () {",
              "    const users = pm.response.json();",
              "    pm.expect(users).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "pm.test(\"GET /users: эхний хэрэглэгчийн нэр = Leanne Graham\", function () {",
              "    pm.expect(pm.response.json()[0].name).to.eql(\"Leanne Graham\");",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [{ "key": "publicUrl", "value": "https://jsonplaceholder.typicode.com" }]
}
